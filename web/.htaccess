# Every path is the single-page app; files that exist are served as usual.
FallbackResource /index.html

AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2
AddType text/javascript .js .mjs

# version.txt announces a new build and service-worker.js carries it: both
# must always arrive fresh, never from an HTTP cache.
<IfModule mod_headers.c>
  <FilesMatch "^(version\.txt|service-worker\.js|index\.html)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  </FilesMatch>
  <FilesMatch "\.(woff2|png|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  Header set Permissions-Policy "microphone=(self)"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
